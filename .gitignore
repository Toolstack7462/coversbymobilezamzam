# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Secrets. Never commit these. `scripts/secret-scan` also gates on them. ────
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
.wrangler/
.cloudflare/
.cf-token
*.token

# ── Build output ──────────────────────────────────────────────────────────────
build/
dist/
.react-router/
.vite/
*.tsbuildinfo

# ── Local databases and backups. These hold real order and customer data. ────
*.sqlite
*.sqlite3
*.db
backups/
db/dumps/
!db/dumps/.gitkeep

# ── Customer-supplied files. Payment proofs are personal data. ───────────────
uploads/
proofs/
private-media/

# ── Test artefacts ────────────────────────────────────────────────────────────
playwright-report/
test-results/
coverage/
blob-report/
.playwright/

# ── Editors and OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
logs/

# Hostinger migration working directory, when it is placed inside the repo.
# The default is ~/hostinger-migration-work, OUTSIDE the repository, because it
# holds database exports and a copy of the media library — every customer
# record the shop has. Neither belongs in Git.
/hostinger-migration-work/
/build/server-node/
