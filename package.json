{
  "name": "italian-tech-atelier-commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-owned ecommerce platform for an Italian mobile-accessories retailer. React Router v8 on Cloudflare Workers, D1 and R2.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:preview": "node scripts/deploy/preview.mjs",
    "deploy:preview": "node scripts/deploy/preview.mjs --deploy",
    "preview:migrate": "wrangler d1 migrations apply DB --env preview --remote",
    "preview:seed": "node scripts/import/seed.mjs --db ita-commerce-preview-db --remote",
    "start": "vite preview",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project workers",
    "test:security": "vitest run --project workers tests/security",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop --project=mobile --project=visual",
    "test:a11y": "playwright test tests/accessibility",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ita-commerce --local",
    "db:migrate:remote": "wrangler d1 migrations apply ita-commerce --remote",
    "db:seed": "node scripts/import/seed.mjs",
    "db:studio": "drizzle-kit studio",
    "locales:check": "node scripts/verify/locale-parity.mjs",
    "migrations:check": "node scripts/verify/migration-check.mjs",
    "budgets": "node scripts/verify/budgets.mjs",
    "secret-scan": "node scripts/secret-scan/scan.mjs",
    "validate-env": "node scripts/validate-env/validate.mjs",
    "backup": "node scripts/backup/export-fts-safe.mjs",
    "restore:test": "node scripts/restore/restore-test.mjs",
    "verify": "node scripts/verify/verify.mjs",
    "reconcile": "node scripts/verify/reconcile-inventory.mjs",
    "media:inventory": "node scripts/verify/media-inventory.mjs",
    "backup:preview": "node scripts/backup/export-fts-safe.mjs --db DB --env preview --remote",
    "smoke:preview": "node scripts/verify/smoke-deployed.mjs https://italian-tech-atelier-commerce-preview.genzdigitaltools7462.workers.dev",
    "mariadb:start": "node scripts/hostinger/local-db.mjs start",
    "mariadb:stop": "node scripts/hostinger/local-db.mjs stop",
    "mariadb:version": "node scripts/hostinger/local-db.mjs version",
    "hostinger:schema": "node scripts/hostinger/generate-schema.mjs",
    "test:db:mariadb": "vitest run --config vitest.mariadb.config.ts",
    "hostinger:sql-audit": "node scripts/hostinger/sql-audit.mjs",
    "build:node": "react-router build --config vite.node.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "build:hostinger": "npm run build:node && npm run build:server",
    "start:hostinger": "node build/server-node/index.js",
    "hostinger:search-rebuild": "node scripts/hostinger/search-rebuild.mjs",
    "hostinger:export": "node scripts/hostinger/export-d1.mjs",
    "hostinger:import": "node scripts/hostinger/import-mariadb.mjs",
    "hostinger:migrate": "node scripts/hostinger/migrate.mjs",
    "hostinger:reserved-words": "node scripts/hostinger/reserved-words.mjs",
    "performance:baseline": "node scripts/hostinger/performance-baseline.mjs",
    "performance:smoke": "node scripts/hostinger/performance-smoke.mjs",
    "verify:hostinger": "npm run verify && npm run test:db:mariadb",
    "test:cache-isolation": "node scripts/hostinger/cache-isolation.mjs",
    "test:inventory-concurrency": "vitest run --config vitest.mariadb.config.ts -t concurren",
    "hostinger:server": "node scripts/hostinger/local-server.mjs",
    "performance:compare": "node scripts/hostinger/performance-compare.mjs",
    "performance:soak": "node scripts/hostinger/performance-soak.mjs",
    "scale:fixture": "node scripts/hostinger/scale-fixture.mjs",
    "job:run": "node scripts/hostinger/run-job.mjs",
    "test:e2e:cross": "playwright test --project=firefox --project=webkit",
    "test:e2e:mariadb": "playwright test --config playwright.mariadb.config.ts",
    "seed:mariadb": "node scripts/hostinger/seed-mariadb.mjs",
    "hostinger:deploy": "node scripts/hostinger/deploy.mjs",
    "hostinger:configure": "node scripts/hostinger/configure.mjs",
    "hostinger:media": "node scripts/hostinger/migrate-media.mjs",
    "hostinger:backup": "node scripts/hostinger/backup.mjs"
  },
  "dependencies": {
    "@react-router/express": "8.3.1",
    "@react-router/node": "8.3.1",
    "better-auth": "1.7.2",
    "compression": "1.8.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "isbot": "5.2.2",
    "mysql2": "3.24.4",
    "nodemailer": "10.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "uqr": "0.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260830.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.1",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/node": "26.4.0",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "ssh2": "^1.17.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
