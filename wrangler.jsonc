{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ita-commerce",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // No workers.dev URL by default. A *.workers.dev address is a public,
  // unauthenticated origin for whatever is deployed to it; the preview
  // environment turns it on deliberately, and nothing else does.
  "workers_dev": false,

  // ── D1: the relational source of truth ────────────────────────────────────
  // database_id is a PLACEHOLDER. Local development does not use it; `--remote`
  // does. Create the database with the command in docs/deployment.md and paste
  // the returned id here. It is an account-scoped identifier, not a secret.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ita-commerce",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "db/migrations",
    },
  ],

  // ── R2: two buckets, deliberately ─────────────────────────────────────────
  // MEDIA is world-readable product imagery served from a public base URL.
  // PRIVATE_FILES holds payment proofs and exports. It must NEVER be given a
  // public bucket URL or an r2.dev domain; every read goes through an
  // authenticated route that checks staff permission and logs the access.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "ita-commerce-media" },
    { "binding": "PRIVATE_FILES", "bucket_name": "ita-commerce-private" },
  ],

  // ── Scheduled work ────────────────────────────────────────────────────────
  // Cron expressions run in UTC, always. The reservation sweeper releases stock
  // held by unpaid orders past their expiry; it is idempotent and safe to run
  // more often than strictly needed. Every five minutes keeps the worst-case
  // over-hold to five minutes without hammering D1.
  "triggers": {
    "crons": ["*/5 * * * *"],
  },

  "vars": {
    "APP_ENV": "development",
    // Non-secret defaults. Real values are set per environment; secrets are set
    // with `wrangler secret put` and never appear in this file.
    "DEFAULT_LOCALE": "it",
    "SUPPORTED_LOCALES": "it,en",
    "DEFAULT_CURRENCY": "EUR",
    "STORE_TIMEZONE": "Europe/Rome",
  },

  "env": {
    /*
     * PREVIEW — an isolated environment on a temporary workers.dev address.
     *
     * Everything here is separate from staging and production: its own Worker,
     * its own D1, its own buckets. Nothing it can reach is shared with an
     * environment that might one day hold real orders.
     *
     * The Worker is named for the project rather than inheriting the short base
     * name, because the name becomes the public hostname and
     * `italian-tech-atelier-commerce-preview.<subdomain>.workers.dev` says what
     * it is to anyone who sees it in a browser bar.
     */
    "preview": {
      "name": "italian-tech-atelier-commerce-preview",

      // The only environment with a public workers.dev hostname, and the whole
      // point of it: a real HTTPS origin, so cookie `Secure`, the `__Host-`
      // prefix and cross-origin redirects behave the way they will in
      // production rather than the way localhost lets them.
      "workers_dev": true,

      "vars": {
        "APP_ENV": "preview",
        "DEFAULT_LOCALE": "it",
        "SUPPORTED_LOCALES": "it,en",
        "DEFAULT_CURRENCY": "EUR",
        "STORE_TIMEZONE": "Europe/Rome",
      },

      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ita-commerce-preview-db",
          // EU jurisdiction: the merchant and their customers are in Italy, so
          // the data stays inside the EU rather than wherever Cloudflare would
          // otherwise place it.
          "database_id": "2f1ee61e-c5bc-410c-884a-59e2886baf27",
          "migrations_dir": "db/migrations",
        },
      ],

      "r2_buckets": [
        // Both buckets are PRIVATE at the R2 level. Product images are served
        // through the Worker's own /media/* route, which sets an immutable
        // cache and a sandboxed CSP; there is no r2.dev domain and no public
        // bucket URL, so the only way in is through code that can be reviewed.
        {
          "binding": "MEDIA",
          "bucket_name": "ita-commerce-preview-media",
          "jurisdiction": "eu",
        },
        // Payment proofs. This one must never gain a public URL under any
        // circumstances: every read goes through an authenticated staff route
        // that logs the access.
        {
          "binding": "PRIVATE_FILES",
          "bucket_name": "ita-commerce-preview-proofs",
          "jurisdiction": "eu",
        },
      ],

      /*
       * Every fifteen minutes, UTC — Cloudflare crons have no timezone, so this
       * fires at :00, :15, :30 and :45 Europe/Rome as well, since Italy is a
       * whole number of hours from UTC in both CET and CEST.
       *
       * Production intent is every five minutes (see the base config): the
       * sweeper's job is to release stock held by unpaid orders, and the
       * interval is the worst-case over-hold. Fifteen is chosen for preview
       * because it is demo data and it keeps well inside the Free plan's
       * request budget, while still being twice inside the thirty-minute
       * window after which /admin/sistema reports the sweeper as stopped.
       */
      "triggers": {
        "crons": ["*/15 * * * *"],
      },
    },

    /*
     * RESTORE-TEST — a disposable target for proving a backup.
     *
     * Declared here rather than created ad hoc because Wrangler can only reach
     * a database that its configuration names, and a restore procedure that
     * requires hand-editing config before it can run is a procedure nobody
     * runs. It exists so `--env restore-test` works.
     *
     * It is NOT a deployable environment: no Worker is ever published to it,
     * and it has no buckets or secrets. The database it points at is created
     * and destroyed by the restore drill. If the database has been deleted —
     * which is the normal resting state — commands against this environment
     * will fail, and that is correct.
     */
    "restore-test": {
      "name": "ita-commerce-restore-test-never-deployed",
      "workers_dev": false,
      /*
       * These two are repeated from the top level, and NOT because this
       * environment uses them — nothing is ever deployed here.
       *
       * `wrangler types` generates one Env type covering every declared
       * environment, so a binding that is missing from any one of them becomes
       * optional in all of them. Leaving these out turned `env.MEDIA` into
       * `R2Bucket | undefined` across the whole application and broke the
       * typecheck in five unrelated files. Wrangler also warns on every command
       * that a top-level `vars`/`r2_buckets` is not inherited by environments.
       *
       * Declaring them keeps the generated types honest for the environments
       * that are real.
       */
      "vars": {
        "APP_ENV": "development",
        "DEFAULT_LOCALE": "it",
        "SUPPORTED_LOCALES": "it,en",
        "DEFAULT_CURRENCY": "EUR",
        "STORE_TIMEZONE": "Europe/Rome",
      },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "ita-commerce-media" },
        { "binding": "PRIVATE_FILES", "bucket_name": "ita-commerce-private" },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ita-commerce-preview-restore-test",
          "database_id": "1f832320-2b10-43be-8f64-9f6427d384f4",
          "migrations_dir": "db/migrations",
        },
      ],
    },

    "staging": {
      "name": "ita-commerce-staging",
      "workers_dev": false,
      "vars": { "APP_ENV": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ita-commerce-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
          "migrations_dir": "db/migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "ita-commerce-media-staging" },
        { "binding": "PRIVATE_FILES", "bucket_name": "ita-commerce-private-staging" },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
    },
    "production": {
      "name": "ita-commerce-production",
      "workers_dev": false,
      "vars": { "APP_ENV": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ita-commerce-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "db/migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "ita-commerce-media-production" },
        { "binding": "PRIVATE_FILES", "bucket_name": "ita-commerce-private-production" },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
    },
  },
}
